# Copy to .env and fill in. .env is never committed.

# SEC EDGAR — required. The SEC blocks requests without a real contact.
SEC_USER_AGENT="Your Name your@email.com"

# LLM — the research agents run locally on Ollama by default (free, offline).
# Install Ollama, then: ollama pull qwen3:8b
LLM_PRIMARY=ollama            # ollama | groq | huggingface
OLLAMA_MODEL=qwen3:8b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=16384        # more context = more RAM; 16k needs ~2.5 GB on top of the model

# Groq — optional, free key at console.groq.com. Much faster than local,
# with daily rate limits. Used as a fallback, or as primary with LLM_PRIMARY=groq.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Hugging Face — optional, token at huggingface.co/settings/tokens.
# Also lets embedding models download without anonymous rate limits.
# Inference credits on the free plan are small; treat it as a last fallback.
HF_TOKEN=
# HF_MODEL=openai/gpt-oss-120b

# Web search for the research agents — optional. Free plan: 1,000 credits/month.
# Without it the agents fall back to DuckDuckGo.
TAVILY_API_KEY=

# LangSmith tracing — optional, free tier at smith.langchain.com.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=value-investor

# Portfolio reporting currency.
BASE_CURRENCY=PLN

# Screening knobs (defaults in value_investor/config.py).
# HURDLE_RATE=0.15
# MIN_QUALITY=70
